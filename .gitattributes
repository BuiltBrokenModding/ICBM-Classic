# Auto detect text files and perform LF normalization
* text=auto

# Windows shit (Windows tends to prefer crlf, even if it can handle lf... even then it breaks)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.xml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# LF gang
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lfs
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.canvas text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.java text eol=lf
*.cs text eol=lf

